    @if (ViewBag.ViewType == "delete")
    {
        <a asp-action="Delete" asp-controller="LanguageCourses" asp-route-id="@Model.Id" class="btn btn-warning">Kustuta</a>
        <a asp-action="Index" asp-controller="LanguageCourses" class="btn btn-warning">Tühista</a>
    }
    else
    {
        <a asp-action="Update" asp-controller="LanguageCourses" class="btn btn-warning">Muuda</a>
