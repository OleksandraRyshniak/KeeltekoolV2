@model Keeltekool_2.Models.LanguageCourses.LanguageCourseViewModel
<h1>Andmed</h1>

@if (ViewBag.ViewType == "details")
{
    <h1>Info</h1>
}
else
{
    <h1>Kustuta</h1>
}

<div>
    <h4>Keelekursus</h4>
    <hr/>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_LanguageCourseGuid">@Html.DisplayFor(model => model.Id)</span>
        </div>
    </dl>
</div>
<div>
    <h4>Keelekursus</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_LanguageCourseNimetus">@Html.DisplayFor(model => model.Nimetus)</span>
        </div>
    </dl>
</div>
<div>
    <h4>Keelekursus</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_LanguageCourseKeel">@Html.DisplayFor(model => model.Keel)</span>
        </div>
    </dl>
</div>
<div>
    <h4>Keelekursus</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_LanguageCourseKirjeldus">@Html.DisplayFor(model => model.Kirjeldus)</span>
        </div>
    </dl>
</div>
<div>
    <h4>Keelekursus</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_LanguageCourseTase">@Html.DisplayFor(model => model.Tase)</span>
        </div>
    </dl>

    @if (ViewBag.ViewType == "delete")
    {
        <form asp-action="DeleteConfirmed">
            <input type="hidden" asp-for="Id"/>
            <input id="DeleteDelete_BTN" type="submit" value="Kustuta" class="btn btn-danger"/>
        </form>
        <br />
        <a id="DeleteCalce_BTN" asp-action="Index" asp-controller="LanguageCourses" class="btn btn-warning">Tühista</a>
    }
    else
    {
        <a id="DetailsUpdate_BTN" asp-action="Update" asp-controller="LanguageCourses" class="btn btn-warning">Muuda</a>
        <a id="DetailsBack_BTN" asp-action="Index" asp-controller="LanguageCourses" class="btn btn-warning">Tagasi</a>
    }
    
</div>
