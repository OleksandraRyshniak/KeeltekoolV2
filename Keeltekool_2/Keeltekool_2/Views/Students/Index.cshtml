@model IEnumerable<Keeltekool_2.Models.Students.StudentIndexViewModel>

@{
    ViewData["Title"] = "Õpilased";
}

<h1>Õpilased</h1>

<p>
    <a asp-action="Create" id="IndexCreateNewStudent_BTN">Lisa uus õpilane</a>
</p>

<table class="table" id="IndexTable">
    <thead>
        <tr>
            <th>Eesnimi</th>
            <th>Perekonnanimi</th>
            <th>Kasutaja ID</th>
            <th>Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td id="IndexTableStudentFirstName">@item.FirstName</td>
                <td id="IndexTableStudentLastName">@item.LastName</td>
                <td id="IndexTableStudentUserID">@item.UserID</td>
                <td id="IndexTableStudentActions">
                    <a asp-action="Details" asp-route-id="@item.Id" id="IndexTableStudentDetails_BTN">Vaata</a>
                    <a asp-action="Update" asp-route-id="@item.Id" id="IndexTableStudentUpdate_BTN">Muuda</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" id="IndexTableStudentDelete_BTN">Kustuta</a>
                </td>
            </tr>
        }
    </tbody>
</table>
